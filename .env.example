# --- Discord ---
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Optional: set this while developing to register slash commands to a single
# guild instantly (global commands take up to an hour to propagate).
DISCORD_GUILD_ID=

# --- Last.fm ---
# Create a key at https://www.last.fm/api/account/create (no callback needed,
# we only use the read-only public API - no user OAuth required).
LASTFM_API_KEY=your-lastfm-api-key

# --- Spotify (optional) ---
# Used only as a cover-art fallback when Last.fm doesn't return artwork
# (increasingly common for artist images). Client Credentials flow only -
# no user login needed. Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Storage ---
# Path to the SQLite file that stores Discord<->Last.fm account links and a
# short-lived API response cache. Point this at a persistent volume/disk on
# whatever host you deploy to.
DATABASE_PATH=./data/bot.sqlite
